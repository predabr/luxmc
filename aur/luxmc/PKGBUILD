# Maintainer: Luxmc contributors
pkgname=luxmc
pkgver=0.7.0.beta
pkgrel=1
pkgdesc="Linux-first Minecraft launcher"
arch=('x86_64')
url="https://github.com/anomalyco/luxmc"
license=('MIT')
depends=(
	'gtk3'
	'webkit2gtk-4.1'
	'libsoup3'
	'openssl'
	'librsvg'
	'libappindicator-gtk3'
	'alsa-lib'
	'libxkbcommon'
	'hicolor-icon-theme'
	'jre-openjdk'
	'unzip'
)
makedepends=(
	'cargo'
	'nodejs'
	'pnpm'
	'npm'
)
provides=('luxmc')
conflicts=('luxmc')
backup=()
options=(!strip)
source=("$pkgname-$pkgver.tar.gz::https://github.com/anomalyco/luxmc/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
	cd "$pkgname-$pkgver"
	export RUSTUP_TOOLCHAIN=stable
	export CARGO_TARGET_DIR=target
	pnpm install --frozen-lockfile
}

build() {
	cd "$pkgname-$pkgver"
	pnpm tauri build 2>&1 | tee build.log
}

package() {
	cd "$pkgname-$pkgver"

	# Binary
	install -Dm755 src-tauri/target/release/luxmc \
		"$pkgdir/usr/bin/luxmc"

	# Desktop file
	install -Dm644 src-tauri/target/release/bundle/deb/*/data/usr/share/applications/io.github.luxmc.Luxmc.desktop \
		"$pkgdir/usr/share/applications/io.github.luxmc.Luxmc.desktop" 2>/dev/null || \
	install -Dm644 src-tauri/icons/io.github.luxmc.Luxmc.desktop \
		"$pkgdir/usr/share/applications/io.github.luxmc.Luxmc.desktop" 2>/dev/null || true

	# Icons
	for size in 32 128 256; do
		local src="src-tauri/icons/${size}x${size}.png"
		local src2x="src-tauri/icons/${size}x${size}@2x.png"
		if [[ -f "$src" ]]; then
			install -Dm644 "$src" \
				"$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/luxmc.png"
		fi
		if [[ -f "$src2x" ]]; then
			install -Dm644 "$src2x" \
				"$pkgdir/usr/share/icons/hicolor/${size}x${size}@2/apps/luxmc.png"
		fi
	done

	# SVG icon if present
	if [[ -f "src-tauri/icons/icon.svg" ]]; then
		install -Dm644 "src-tauri/icons/icon.svg" \
			"$pkgdir/usr/share/icons/hicolor/scalable/apps/luxmc.svg"
	fi
}
