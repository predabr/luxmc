# Maintainer: Pedro <suporte@luxmc.com>
pkgname=luxmc
pkgver=1.2.0.alpha
_tagver="1.2.0-alpha"
pkgrel=1
pkgdesc="Linux-first Minecraft launcher"
arch=('x86_64')
url="https://github.com/predabr/luxmc"
license=('Proprietary')
depends=(
	'gtk3'
	'webkit2gtk-4.1'
	'libsoup3'
	'openssl'
	'librsvg'
	'libayatana-appindicator'
	'alsa-lib'
	'libxkbcommon'
	'hicolor-icon-theme'
	'jre-openjdk'
	'unzip'
	'xdg-utils'
)
makedepends=(
	'cargo'
	'nodejs'
	'pnpm'
)
provides=('luxmc')
conflicts=('luxmc')
backup=()
options=(!strip)
source=("$pkgname-$pkgver.tar.gz::https://github.com/predabr/luxmc/archive/refs/tags/v${_tagver}.tar.gz")
sha256sums=('SKIP')

prepare() {
	cd "luxmc-${_tagver}"
	export RUSTUP_TOOLCHAIN=stable
	export CARGO_TARGET_DIR=target
	pnpm install --frozen-lockfile
}

build() {
	cd "luxmc-${_tagver}"
	pnpm tauri build 2>&1 | tee build.log
}

package() {
	cd "luxmc-${_tagver}"

	# Binary
	install -Dm755 src-tauri/target/release/luxmc \
		"$pkgdir/usr/bin/luxmc"

	# Desktop file
	install -Dm644 src-tauri/icons/io.github.luxmc.Luxmc.desktop \
		"$pkgdir/usr/share/applications/io.github.luxmc.Luxmc.desktop" 2>/dev/null || \
	install -Dm644 src-tauri/target/release/bundle/deb/*/data/usr/share/applications/*.desktop \
		"$pkgdir/usr/share/applications/Luxmc.desktop" 2>/dev/null || true

	# Icons
	for size in 32 64 128 256; do
		local src="src-tauri/icons/${size}x${size}.png"
		local src2x="src-tauri/icons/${size}x${size}@2x.png"
		if [[ -f "$src" ]]; then
			install -Dm644 "$src" \
				"$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/luxmc.png"
		fi
		if [[ -f "$src2x" ]]; then
			install -Dm644 "$src2x" \
				"$pkgdir/usr/share/icons/hicolor/${size}x${size}@2/apps/luxmc.png"
		fi
	done
}
