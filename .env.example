# Luxmc Launcher — Environment Configuration Template
# Copy this file to .env or export these variables in your environment.

# CurseForge API Key (optional — required only to search and download CurseForge mods)
# Obtain a key at https://console.curseforge.com/
CURSEFORGE_API_KEY=

# Custom Microsoft Azure App Client ID (optional — uses default if not set)
LUXMC_MS_CLIENT_ID=

# Developer Mode (0 = disabled, 1 = enabled)
LUXMC_DEV_MODE=0

# Hardware rendering on Linux (0 = use GPU DMA-BUF acceleration, 1 = software rasterizer fallback)
LUXMC_SOFTWARE_RENDER=0
