# Maintainer: Pedro <suporte@luxmc.com>
pkgname=luxmc-bin
pkgver=1.3.1.alpha
_tagver="1.3.1-alpha"
pkgrel=1
pkgdesc="Linux-first Minecraft launcher (prebuilt binary)"
arch=('x86_64')
url="https://github.com/predabr/luxmc"
license=('Proprietary')
depends=(
    'webkit2gtk-4.1'
    'gtk3'
    'libsoup3'
    'openssl'
    'librsvg'
    'libayatana-appindicator'
    'hicolor-icon-theme'
    'xdg-utils'
)
optdepends=(
    'gamemode: Feral GameMode integration for performance boost'
    'vulkan-radeon: RADV driver for AMD Vulkan acceleration'
    'vulkan-intel: ANV driver for Intel Vulkan acceleration'
)
provides=('luxmc')
conflicts=('luxmc')
source=("https://github.com/predabr/luxmc/releases/download/v${_tagver}/Luxmc_${_tagver}_amd64.deb")
sha256sums=('5682ee30fdcc3e85544da7d96fe34c8c98e7437f342e6c77efacc8a23ed9b321')

package() {
    bsdtar -xf "${srcdir}/data.tar.gz" -C "${pkgdir}"
    chmod 755 "${pkgdir}/usr/bin/luxmc"
}
