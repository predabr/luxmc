# Maintainer: Pedro <suporte@luxmc.com>
pkgname=luxmc-bin
pkgver=2.0.0
pkgrel=1
pkgdesc="Linux-first Minecraft launcher (pre-compiled binary)"
arch=('x86_64')
url="https://github.com/predabr/luxmc"
license=('MIT')
provides=('luxmc' 'luxmc-launcher')
conflicts=('luxmc' 'luxmc-launcher')
depends=(
    'webkit2gtk-4.1'
    'gtk3'
    'libsoup3'
    'openssl'
    'librsvg'
    'libayatana-appindicator'
    'hicolor-icon-theme'
    'xdg-utils'
)
optdepends=(
    'gamemode: Feral GameMode integration for performance boost'
    'vulkan-radeon: RADV driver for AMD Vulkan acceleration'
    'vulkan-intel: ANV driver for Intel Vulkan acceleration'
)
source=("https://github.com/predabr/luxmc/releases/download/v${pkgver}/Luxmc_${pkgver}_amd64.AppImage"
        "luxmc.desktop"
        "https://raw.githubusercontent.com/predabr/luxmc/main/src-tauri/icons/icon.png")
sha256sums=('SKIP'
            'SKIP'
            'SKIP')

package() {
    install -Dm755 "${srcdir}/Luxmc_${pkgver}_amd64.AppImage" "${pkgdir}/usr/bin/luxmc"
    install -Dm644 "${srcdir}/luxmc.desktop" "${pkgdir}/usr/share/applications/luxmc.desktop"
    install -Dm644 "${srcdir}/icon.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/luxmc.png"
}
