{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Luxmc",
  "version": "3.6.0",
  "identifier": "io.github.luxmc.Luxmc",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build",
    "beforeBundleCommand": "node scripts/build-repair-helper.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "Luxmc",
        "backgroundColor": [10, 11, 15, 255],
        "url": "/",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": true,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' asset: http://asset.localhost https: data: blob:; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' wss: http://127.0.0.1:* ipc: http://ipc.localhost https: asset: http://asset.localhost; media-src 'self' http://127.0.0.1:* asset: http://asset.localhost https: blob: data:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-src https://luxmc-r92.pages.dev",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**/*.png",
            "**/*.jpg",
            "**/*.jpeg",
            "**/*.webp",
            "**/*.gif",
            "**/*.bmp",
            "**/*.ico",
            "**/*.mp3",
            "**/*.ogg",
            "**/*.wav",
            "**/*.mp4",
            "**/*.webm"
          ],
          "deny": [
            "**/social/**"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb",
      "rpm",
      "dmg"
    ],
    "category": "Game",
    "publisher": "Luxmc",
    "homepage": "https://luxmc-r92.pages.dev",
    "copyright": "Luxmc",
    "shortDescription": "Minecraft launcher for Windows and Linux.",
    "longDescription": "Luxmc manages Minecraft versions, modpacks, player appearance and multiplayer rooms on Windows and Linux.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libgtk-3-0",
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "librsvg2-2",
          "hicolor-icon-theme",
          "xdg-utils"
        ],
        "desktopTemplate": "../packaging/arch/luxmc.desktop"
      },
      "rpm": {
        "depends": [
          "gtk3",
          "webkit2gtk4.1",
          "libayatana-appindicator-gtk3",
          "librsvg2",
          "hicolor-icon-theme",
          "xdg-utils"
        ],
        "desktopTemplate": "../packaging/arch/luxmc.desktop"
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "PortugueseBR"
        ],
        "headerImage": "../packaging/windows/header.bmp",
        "sidebarImage": "../packaging/windows/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "../packaging/windows/hooks.nsh",
        "compression": "lzma",
        "startMenuFolder": "Luxmc",
        "template": "../packaging/windows/recovery-installer.nsi"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "wix": {
        "language": "en-US"
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.13"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "luxmc"
        ]
      }
    }
  }
}
