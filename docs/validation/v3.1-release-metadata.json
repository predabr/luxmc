s/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/zip","state":"uploaded","size":20479497,"digest":"sha256:2dc2228e8c595e06a8042e88ee193fc9a146230f1a287d9fe16fe4c3346231aa","download_count":0,"created_at":"2026-10-07T03:36:38Z","updated_at":"2026-10-07T03:36:39Z","browser_download_url":"https://github.com/predabr/luxmc/releases/download/v3.1.0/Luxmc_3.1.0_x64-setup.exe"},{"url":"https://api.github.com/repos/predabr/luxmc/releases/assets/617469773","id":617469773,"node_id":"RA_kwDOUQmo7M4kzddN","name":"SHA256SUMS","label":"","uploader":{"login":"predabr","id":218385324,"node_id":"U_kgDODQRLrA","avatar_url":"https://avatars.githubusercontent.com/u/218385324?v=4","gravatar_id":"","url":"https://api.github.com/users/predabr","html_url":"https://github.com/predabr","followers_url":"https://api.github.com/users/predabr/followers","following_url":"https://api.github.com/users/predabr/following{/other_user}","gists_url":"https://api.github.com/users/predabr/gists{/gist_id}","starred_url":"https://api.github.com/users/predabr/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/predabr/subscriptions","organizations_url":"https://api.github.com/users/predabr/orgs","repos_url":"https://api.github.com/users/predabr/repos","events_url":"https://api.github.com/users/predabr/events{/privacy}","received_events_url":"https://api.github.com/users/predabr/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":641,"digest":"sha256:955b8be827b220572bbcd1477ba8bba4e0dc73ae77bf518c00a527a76b79001a","download_count":0,"created_at":"2026-10-07T03:41:36Z","updated_at":"2026-10-07T03:41:36Z","browser_download_url":"https://github.com/predabr/luxmc/releases/download/v3.1.0/SHA256SUMS"}],"tarball_url":"https://api.github.com/repos/predabr/luxmc/tarball/v3.1.0","zipball_url":"https://api.github.com/repos/predabr/luxmc/zipball/v3.1.0","body":"# Luxmc 3.1.0\r\n\r\nEsta versão melhora a biblioteca de instâncias, os catálogos e a recuperação do aplicativo, mantendo o nome Luxmc.\r\n\r\n- Nova organização da criação de instâncias e do instalador de modpacks, com controles legíveis nos temas claro e escuro.\r\n- Logos de modpacks preservadas no catálogo e recuperação de arte oficial para instâncias com ícone padrão.\r\n- Imagens dos mods e packs com miniaturas limitadas, carregamento sob demanda e cache invalidado quando o arquivo muda. Datapacks são gerenciados no mundo selecionado.\r\n- Aviso persistente para aplicar e sincronizar alterações de skins importadas do NameMC.\r\n- Revisões da rolagem, das bordas de conteúdo e das traduções; remoção da oferta de pacotes de mods de performance, preservando as outras otimizações.\r\n- Verificador independente no Windows: confere os arquivos do aplicativo ao abrir pelo atalho e recupera uma cópia local validada. Quando uma versão anterior válida estiver disponível, pode restaurá-la. Contas, mundos e arquivos das instâncias ficam fora da recuperação.\r\n- Atualizações com verificação de tamanho e novas tentativas após interrupções; publicação inclui manifesto e hashes dos instaladores.\r\n\r\nNa primeira instalação com o verificador, a recuperação usa uma cópia da própria versão instalada. Sem nenhuma cópia válida, é necessário reinstalar. Conteúdos que não fornecem uma imagem usam o símbolo de sua categoria.\r\n\r\nA instalação existente não é atualizada automaticamente por esta publicação: abra o launcher e use a verificação de atualizações para testar a passagem à versão 3.1.0.\r\n"}
